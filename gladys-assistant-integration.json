{
  "manifest_version": 1,
  "type": "device",
  "name": "PetKit",
  "description": {
    "en": "PetKit feeders, litter boxes and fountains: food, litter, water, filter, pets, alerts.",
    "fr": "Distributeurs, litières et fontaines PetKit : croquettes, litière, eau, filtre, alertes."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/lm1lc3n7/gladys-petkit:0.1.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/LM1LC3N7/gladys-petkit/main/cover.png",
  "categories": ["appliances"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your PetKit account",
        "fr": "Votre compte PetKit"
      },
      "description": {
        "en": "Brings your PetKit devices into Gladys through the PetKit cloud: food level and food dispensed by the feeders (Fresh Element, YumShare…), litter level, waste bin and visits of the litter boxes (Pura X, Pura Max, Purobot…) with the weight of each cat, water level, filter and pump of the Eversweet fountains, plus feeding, cleaning and deodorizing buttons and scene triggers. PetKit allows one session per account: use a second PetKit account added to your family in the PetKit app (see the guide), otherwise the app and Gladys sign each other out. Choose the PetKit server of your account, then add the devices from the Discovery tab. Unofficial, not affiliated with PetKit.",
        "fr": "Amène vos appareils PetKit dans Gladys par le cloud PetKit : niveau et quantité distribuée des distributeurs (Fresh Element, YumShare…), niveau de litière, bac à déchets et passages des litières (Pura X, Pura Max, Purobot…) avec le poids de chaque chat, niveau d'eau, filtre et pompe des fontaines Eversweet, plus des boutons pour distribuer, nettoyer et désodoriser et des déclencheurs de scène. PetKit n'autorise qu'une session par compte : utilisez un second compte PetKit ajouté à votre famille dans l'application PetKit (voir le guide), sinon l'application et Gladys se déconnectent mutuellement. Choisissez le serveur PetKit de votre compte, puis ajoutez les appareils depuis l'onglet Découverte. Non officiel, sans lien avec PetKit."
      },
      "links": [
        {
          "url": "https://github.com/LM1LC3N7/gladys-petkit/blob/main/docs/fr.md",
          "label": {
            "en": "Guide (French)",
            "fr": "Guide (français)"
          }
        },
        {
          "url": "https://github.com/LM1LC3N7/gladys-petkit/blob/main/docs/en.md",
          "label": {
            "en": "Guide (English)",
            "fr": "Guide (anglais)"
          }
        }
      ]
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "PetKit e-mail or phone number",
        "fr": "E-mail ou téléphone PetKit"
      },
      "placeholder": {
        "en": "gladys@example.com",
        "fr": "gladys@exemple.fr"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "PetKit password",
        "fr": "Mot de passe PetKit"
      },
      "required": true
    },
    {
      "key": "region",
      "type": "select",
      "label": {
        "en": "PetKit server",
        "fr": "Serveur PetKit"
      },
      "description": {
        "en": "The server of the country chosen when the account was created: Europe (France, Belgium, Switzerland, United Kingdom…), International (Americas, Australia…), Asia, Russia or China.",
        "fr": "Le serveur du pays choisi à la création du compte : Europe (France, Belgique, Suisse, Royaume-Uni…), International (Amériques, Australie…), Asie, Russie ou Chine."
      },
      "required": true,
      "default": "europe",
      "options": [
        {
          "value": "europe",
          "label": {
            "en": "Europe",
            "fr": "Europe"
          }
        },
        {
          "value": "international",
          "label": {
            "en": "International (Americas, Australia…)",
            "fr": "International (Amériques, Australie…)"
          }
        },
        {
          "value": "asia",
          "label": {
            "en": "Asia",
            "fr": "Asie"
          }
        },
        {
          "value": "russia",
          "label": {
            "en": "Russia",
            "fr": "Russie"
          }
        },
        {
          "value": "china",
          "label": {
            "en": "China",
            "fr": "Chine"
          }
        }
      ]
    },
    {
      "key": "timezone",
      "type": "string",
      "label": {
        "en": "Time zone of the devices",
        "fr": "Fuseau horaire des appareils"
      },
      "description": {
        "en": "Leave empty to use the time zone of Gladys. Otherwise an IANA name such as Europe/Paris.",
        "fr": "Laissez vide pour utiliser le fuseau horaire de Gladys. Sinon un nom IANA comme Europe/Paris."
      },
      "placeholder": {
        "en": "Europe/Paris",
        "fr": "Europe/Paris"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "poll_interval",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)"
      },
      "description": {
        "en": "How often the devices are read, in seconds (60 to 900). Two requests per feeder or litter box, one per fountain.",
        "fr": "Fréquence de lecture des appareils, en secondes (60 à 900). Deux requêtes par distributeur ou litière, une par fontaine."
      },
      "required": false,
      "default": 120,
      "min": 60,
      "max": 900
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms des fonctionnalités"
      },
      "description": {
        "en": "Used for the names of the features, the litter box states and the alert messages.",
        "fr": "Sert aux noms des fonctionnalités, aux états des litières et aux messages d'alerte."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français"
          }
        },
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion"
      },
      "timeout_seconds": 90
    }
  ],
  "scene_triggers": [
    {
      "key": "litter_box_used",
      "label": {
        "en": "Litter box used",
        "fr": "Litière utilisée"
      },
      "description": {
        "en": "A PetKit litter box recorded a visit, with the cat it recognized, its weight and the time spent.",
        "fr": "Une litière PetKit a enregistré un passage, avec le chat reconnu, son poids et le temps passé."
      },
      "fields": [
        {
          "key": "litter_box",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Litter box",
            "fr": "Litière"
          }
        },
        {
          "key": "pet",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Pet",
            "fr": "Animal"
          }
        }
      ],
      "variables": [
        {
          "key": "litter_box_name",
          "type": "string",
          "label": {
            "en": "Litter box name",
            "fr": "Nom de la litière"
          }
        },
        {
          "key": "pet_name",
          "type": "string",
          "label": {
            "en": "Pet name",
            "fr": "Nom de l'animal"
          }
        },
        {
          "key": "weight",
          "type": "number",
          "label": {
            "en": "Weight (kg)",
            "fr": "Poids (kg)"
          }
        },
        {
          "key": "duration",
          "type": "number",
          "label": {
            "en": "Time spent (s)",
            "fr": "Temps passé (s)"
          }
        },
        {
          "key": "at",
          "type": "string",
          "label": {
            "en": "Time (UTC)",
            "fr": "Heure (UTC)"
          }
        }
      ]
    },
    {
      "key": "meal_dispensed",
      "label": {
        "en": "Meal dispensed",
        "fr": "Repas distribué"
      },
      "description": {
        "en": "A PetKit feeder dispensed a meal of its plan, from the app or from its button (not the ones asked by Gladys).",
        "fr": "Un distributeur PetKit a distribué un repas de son programme, depuis l'application ou depuis son bouton (pas ceux demandés par Gladys)."
      },
      "fields": [
        {
          "key": "feeder",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Feeder",
            "fr": "Distributeur"
          }
        }
      ],
      "variables": [
        {
          "key": "feeder_name",
          "type": "string",
          "label": {
            "en": "Feeder name",
            "fr": "Nom du distributeur"
          }
        },
        {
          "key": "amount",
          "type": "number",
          "label": {
            "en": "Amount",
            "fr": "Quantité"
          }
        },
        {
          "key": "unit",
          "type": "string",
          "label": {
            "en": "Unit (g or portions)",
            "fr": "Unité (g ou portions)"
          }
        },
        {
          "key": "source",
          "type": "string",
          "label": {
            "en": "Source (plan, app, feeder)",
            "fr": "Origine (plan, app, feeder)"
          }
        },
        {
          "key": "at",
          "type": "string",
          "label": {
            "en": "Time (UTC)",
            "fr": "Heure (UTC)"
          }
        }
      ]
    },
    {
      "key": "alert_raised",
      "label": {
        "en": "PetKit alert",
        "fr": "Alerte PetKit"
      },
      "description": {
        "en": "A PetKit device starts reporting a problem: food low, waste bin full, litter low, deodorizer low, water low, filter to change or an error.",
        "fr": "Un appareil PetKit commence à signaler un problème : croquettes bientôt épuisées, bac à déchets plein, litière insuffisante, désodorisant bas, manque d'eau, filtre à changer ou une erreur."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Device",
            "fr": "Appareil"
          }
        },
        {
          "key": "alert",
          "type": "multi_select",
          "label": {
            "en": "Alert",
            "fr": "Alerte"
          },
          "options": [
            {
              "value": "low_food",
              "label": {
                "en": "Food running low",
                "fr": "Croquettes bientôt épuisées"
              }
            },
            {
              "value": "bin_full",
              "label": {
                "en": "Waste bin full",
                "fr": "Bac à déchets plein"
              }
            },
            {
              "value": "litter_low",
              "label": {
                "en": "Litter running low",
                "fr": "Litière insuffisante"
              }
            },
            {
              "value": "deodorizer_low",
              "label": {
                "en": "Deodorizer liquid low",
                "fr": "Liquide désodorisant bas"
              }
            },
            {
              "value": "low_water",
              "label": {
                "en": "Water running low",
                "fr": "Manque d'eau"
              }
            },
            {
              "value": "filter_change",
              "label": {
                "en": "Filter to change",
                "fr": "Filtre à changer"
              }
            },
            {
              "value": "device_error",
              "label": {
                "en": "Device error",
                "fr": "Erreur de l'appareil"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "device_name",
          "type": "string",
          "label": {
            "en": "Device name",
            "fr": "Nom de l'appareil"
          }
        },
        {
          "key": "message",
          "type": "string",
          "label": {
            "en": "Alert message",
            "fr": "Message de l'alerte"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "feed",
      "label": {
        "en": "Feed with a PetKit feeder",
        "fr": "Distribuer avec un distributeur PetKit"
      },
      "description": {
        "en": "Dispenses food now: grams on the single-hopper feeders (Fresh Element Solo and YumShare Solo: 10 to 50 by 10; Mini: 5 to 50 by 5; Infinity: 5 to 200), portions on the two-hopper ones (Gemini, YumShare Dual-hopper: 1 to 10).",
        "fr": "Distribue des croquettes maintenant : en grammes sur les distributeurs à un réservoir (Fresh Element Solo et YumShare Solo : 10 à 50 par 10 ; Mini : 5 à 50 par 5 ; Infinity : 5 à 200), en portions sur ceux à deux réservoirs (Gemini, YumShare Dual-hopper : 1 à 10)."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "feeder",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Feeder",
            "fr": "Distributeur"
          },
          "required": true
        },
        {
          "key": "amount",
          "type": "number",
          "label": {
            "en": "Amount (grams or portions)",
            "fr": "Quantité (grammes ou portions)"
          },
          "required": true,
          "default": 10,
          "min": 1,
          "max": 400
        },
        {
          "key": "hopper",
          "type": "select",
          "label": {
            "en": "Hopper (two-hopper feeders)",
            "fr": "Réservoir (distributeurs à deux réservoirs)"
          },
          "required": false,
          "default": "1",
          "options": [
            {
              "value": "1",
              "label": {
                "en": "Hopper 1",
                "fr": "Réservoir 1"
              }
            },
            {
              "value": "2",
              "label": {
                "en": "Hopper 2",
                "fr": "Réservoir 2"
              }
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "amount",
          "type": "number",
          "label": {
            "en": "Amount asked",
            "fr": "Quantité demandée"
          }
        },
        {
          "key": "unit",
          "type": "string",
          "label": {
            "en": "Unit (g or portions)",
            "fr": "Unité (g ou portions)"
          }
        }
      ]
    }
  ]
}
